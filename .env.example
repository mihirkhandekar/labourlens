# Server-side only. Never commit .env or real credentials.
# OpenAI generation and hosted embeddings; unnecessary for corpus-free tests.
OPENAI_API_KEY=
# Gemini is not used by the installed runtime; no GEMINI_API_KEY is required.

# Live web workspace is disabled unless every code has >=16 characters and
# the session secret has >=32. Generate random values, do not use examples.
LABOURLENS_ACCESS_CODES=
LABOURLENS_SESSION_SECRET=
LABOURLENS_DEMO_ENABLED=true
LABOURLENS_DAILY_BUDGET_USD=2.0
# Optional deployment/version suffix.
LABOURLENS_BUILD=
# Trust only your proxy IP(s); never '*'. Local default is loopback.
LABOURLENS_FORWARDED_ALLOW_IPS=127.0.0.1
# Optional stable HMAC secret; unset creates a private persisted installation key.
LABOURLENS_AUDIT_SALT=
# Optional loopback MCP HTTP transport token (>=24 random characters).
LABOURLENS_MCP_TOKEN=
# Keep guards enabled. 'off' is only for explicitly labelled threat experiments.
LABOURLENS_GUARDS=on
# Private local debugging only: true persists full evidence in run traces.
# Default false stores evidence ids/hashes and the answer, not full passages.
LABOURLENS_DEBUG_EVIDENCE=false
