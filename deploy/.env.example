# Template for /srv/labourlens/.env on the Droplet (mode 600). Replace every REPLACE-... value; never commit real values.
# Generate random values with: openssl rand -hex 32
# Live mode requires session secret >=32 characters and EVERY access code >=16 characters; use independent random values, not memorable codes.
# LABOURLENS_AUDIT_SALT is the secret HMAC key for audit pseudonyms. If unset, a random installation key is persisted locally (0600).
# The app persists a conservative $0.05 reservation before each live run; this is not a proven worst-case billing bound. Set a provider-side cap too.
DOMAIN=labourlens.example.org
# Lower-case GHCR repository published by YOUR workflow. IMAGE_TAG selects a commit within it, not the repository.
LABOURLENS_IMAGE=ghcr.io/<your-github-owner>/<your-repository>
OPENAI_API_KEY=sk-REPLACE-WITH-A-RESTRICTED-PROJECT-KEY
LABOURLENS_ACCESS_CODES=REPLACE-WITH-RANDOM-CODE-1,REPLACE-WITH-RANDOM-CODE-2
LABOURLENS_SESSION_SECRET=REPLACE-64-HEX-CHARACTERS
LABOURLENS_AUDIT_SALT=REPLACE-64-HEX-CHARACTERS
LABOURLENS_DAILY_BUDGET_USD=2.0
LABOURLENS_DEMO_ENABLED=false
